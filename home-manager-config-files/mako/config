# Mako notification daemon — Catppuccin Macchiato
# Symlinked from ~/.config/mako/config; apply edits with `makoctl reload`.

font=JetBrainsMono Nerd Font 11
width=380
height=140
margin=10
padding=14
border-size=2
border-radius=12
icons=1
max-icon-size=48
layer=overlay
anchor=top-right
default-timeout=8000
max-visible=5
group-by=app-name

background-color=#24273aee
text-color=#cad3f5
border-color=#7dc4e4
progress-color=over #8aadf4

[urgency=low]
border-color=#494d64
default-timeout=5000

[urgency=critical]
border-color=#ed8796
text-color=#ed8796
default-timeout=0

[mode=do-not-disturb]
invisible=1

[grouped]
format=<b>%s (%g)</b>\n%b
