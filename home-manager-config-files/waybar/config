// Waybar — Himal Himal (docs/THEME.md)
//
// Three frosted ink islands. Left is identity (os · workspaces · window · now
// playing), centre is time (Bikram Sambat date · clock · ekagra focus timer ·
// weather), right is state (vitals · radios · power).
//
// Two drawers keep the right island short: 󰇘 folds the click-actions, and
// hovering the cpu pill slides out the deeper vitals (per-core heat strip,
// disk, live throughput). Neither costs anything while folded.
//
// Live-editable: symlinked from ~/.config/waybar/config.
//   style.css reloads on save;  config changes need `systemctl --user reload waybar`
//   (waybar runs as a supervised user service — see modules/home-manager/desktop/waybar.nix).
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/os",
        "hyprland/workspaces",
        "hyprland/submap",
        "hyprland/window",
        "mpris",
        "custom/cava"
    ],
    "modules-center": [
        "custom/patro",
        "clock",
        "custom/focus",
        "custom/weather"
    ],
    "modules-right": [
        "privacy",
        "custom/record",
        "systemd-failed-units",
        "group/utils",
        "tray",
        "group/vitals",
        "temperature",
        "memory",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    // ── left ────────────────────────────────────────────────────────────

    "custom/os": {
        "format": "󱄅",
        "tooltip": false,
        "on-click": "fuzzel",
        "on-click-right": "patro notify"
    },

    // Each numeral carries a faint trail of glyphs for the windows living on
    // it, so an unfocused workspace answers "what's over there?" without a
    // visit. Glyphs ride a smaller, dimmer span; empty workspaces stay bare.
    // Unknown classes fall back to a generic app mark.
    "hyprland/workspaces": {
        "format": "{icon}<span size='85%' alpha='70%'>{windows}</span>",
        "format-window-separator": "",
        "window-rewrite-default": " 󰘔",
        "window-rewrite": {
            "class<kitty|com.mitchellh.ghostty|org.wezfurlong.wezterm>": " 󰆍",
            "class<dropterm>": "",
            "class<firefox>": " 󰈹",
            "class<google-chrome|chromium-browser>": " 󰊯",
            "class<[Mm]icrosoft-edge.*>": " 󰇩",
            "class<brave-browser>": " 󰖟",
            "class<code|Code|code-url-handler>": " 󰨞",
            "class<jetbrains-.*>": " 󱃖",
            "class<DBeaver|dbeaver>": " 󱘲",
            "class<obsidian>": " 󰺿",
            "class<anki|Anki>": " 󰘹",
            "class<org.kde.dolphin>": " 󰉖",
            "class<[Ss]lack>": " 󰒱",
            "class<discord|vesktop>": " 󰙯",
            "class<[Ss]potify>": " 󰓇",
            "class<evolution|org.gnome.Evolution|thunderbird>": " 󰇰",
            "class<mpv|vlc>": " 󰿎",
            "class<swayimg|imv>": " 󰋩",
            "class<waybar-tui>": " 󰄨",
            "class<org.pulseaudio.pavucontrol|pavucontrol>": " 󰕾"
        },
        "format-icons": {
            "1": "१",
            "2": "२",
            "3": "३",
            "4": "४",
            "5": "५",
            "6": "६",
            "7": "७",
            "8": "८",
            "9": "९",
            "10": "१०"
        },
        "on-click": "activate",
        // hyprctl dispatch wraps hl.dispatch(...) under the Lua config manager
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    // active hyprland submap (resize mode) — empty and invisible otherwise
    "hyprland/submap": {
        "format": "󰌌 {}",
        "max-length": 14,
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 38,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Google Chrome": "󰊯  $1",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*) - kitty": "󰆍  $1",
            "(.*) - NVIM": "  $1",
            "nvim (.*)": "  $1",
            "(.*) — Dolphin": "󰉋  $1",
            "Spotify( Premium)?": "󰓇  spotify",
            "Slack \\| (.*)": "󰒱  $1"
        }
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 30,
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "󰐊",
            "spotify": "󰓇",
            "chromium": "󰊯",
            "firefox": "󰈹"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "{player}: {title} — {artist}"
    },

    "custom/cava": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/cava.sh",
        "format": "{}",
        "tooltip": false
    },

    // ── centre ──────────────────────────────────────────────────────────

    // Bikram Sambat — today's Bikram Sambat date (lib/patro.nix).
    // Changes once a day; polled hourly because that costs nothing and keeps
    // the bar honest across midnight without a timer of its own.
    "custom/patro": {
        "exec": "patro waybar",
        "return-type": "json",
        "interval": 3600,
        "on-click": "patro notify",
        "tooltip": true
    },

    "clock": {
        "interval": 60,
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰸗  {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#E6C384'><b>{}</b></span>",
                "days": "<span color='#DCD7BA'>{}</span>",
                "weekdays": "<span color='#7FB4CA'><b>{}</b></span>",
                "today": "<span color='#7E9CD8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ekagra (एकाग्र, "one-pointed") — a focus timer. The script is a tiny
    // daemon blocked on a FIFO read: idle it costs nothing, running it wakes
    // once a minute. Counts down in Devanagari numerals, like the workspaces.
    //   click: start 25 min / stop · scroll up: +5 min · right-click: stop
    "custom/focus": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/focus.sh",
        "return-type": "json",
        "on-click": "/home/hubert/nixos/home-manager-config-files/waybar/focus.sh toggle",
        "on-click-right": "/home/hubert/nixos/home-manager-config-files/waybar/focus.sh stop",
        "on-scroll-up": "/home/hubert/nixos/home-manager-config-files/waybar/focus.sh add",
        "escape": false
    },

    "custom/weather": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "on-click": "xdg-open https://wttr.in"
    },

    // ── right ───────────────────────────────────────────────────────────

    "privacy": {
        "icon-spacing": 8,
        "icon-size": 14,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },

    // screen recording in progress — invisible otherwise. record.sh signals
    // RTMIN+9 on start and stop, so this never polls. Click stops.
    "custom/record": {
        "exec": "/home/hubert/nixos/dotfiles/hypr/scripts/record.sh status",
        "return-type": "json",
        "signal": 9,
        "on-click": "/home/hubert/nixos/dotfiles/hypr/scripts/record.sh stop"
    },

    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "󰀦 {nr_failed}",
        "system": true,
        "user": true
    },

    // Utility drawer — click-actions, not readouts, so they stay folded away
    // behind one glyph and slide out on hover. Nothing here needs watching.
    "group/utils": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "transition-left-to-right": false,
            "children-class": "utils-child",
            "click-to-reveal": false
        },
        "modules": [
            "custom/utils",
            "custom/docker",
            "custom/screenshot",
            "custom/screencast",
            "custom/picker",
            "custom/clipboard",
            "custom/wallpaper",
            "custom/keys",
            "idle_inhibitor"
        ]
    },

    "custom/utils": {
        "format": "󰇘",
        "tooltip": false
    },

    "custom/docker": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/docker.sh",
        "return-type": "json",
        "interval": 15,
        "on-click": "kitty --class waybar-tui -e docker stats"
    },

    "custom/screenshot": {
        "format": "󰄀",
        "tooltip": false,
        "on-click": "flameshot gui"
    },

    "custom/screencast": {
        "format": "󰯜",
        "tooltip-format": "record a region · right-click: whole screen",
        "on-click": "/home/hubert/nixos/dotfiles/hypr/scripts/record.sh region",
        "on-click-right": "/home/hubert/nixos/dotfiles/hypr/scripts/record.sh screen"
    },

    "custom/picker": {
        "format": "󰈊",
        "tooltip-format": "pick a colour — hex lands in the clipboard",
        "on-click": "hyprpicker -a"
    },

    "custom/keys": {
        "format": "󰥻",
        "tooltip-format": "keybindings (SUPER+/)",
        "on-click": "/home/hubert/nixos/dotfiles/hypr/scripts/keys.sh"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "on-click": "cliphist list | fuzzel --dmenu --width 70 --lines 15 | cliphist decode | wl-copy",
        "tooltip": false
    },

    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip-format": "next wallpaper",
        "on-click": "wallpaper next",
        "on-click-right": "wallpaper random"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "caffeine on — screen stays awake",
        "tooltip-format-deactivated": "caffeine off"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    // Vitals drawer — cpu stays on the bar; hovering it slides out the
    // readouts you only want on demand.
    "group/vitals": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "transition-left-to-right": false,
            "children-class": "vitals-child",
            "click-to-reveal": false
        },
        "modules": [
            "cpu",
            "cpu#cores",
            "disk",
            "network#speed"
        ]
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠  {usage}%",
        "tooltip": true,
        "on-click": "kitty --class waybar-tui -e btop"
    },

    // one block glyph per hardware thread, coloured by heat — the whole
    // processor drawn as a strip of ink. Cool water → gold → peach at 100%.
    "cpu#cores": {
        "interval": 5,
        "format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}{icon8}{icon9}{icon10}{icon11}{icon12}{icon13}{icon14}{icon15}",
        "format-icons": [
            "<span color='#54546D'>▁</span>",
            "<span color='#658594'>▂</span>",
            "<span color='#7AA89F'>▃</span>",
            "<span color='#7FB4CA'>▄</span>",
            "<span color='#E6C384'>▅</span>",
            "<span color='#FFA066'>▆</span>",
            "<span color='#E46876'>▇</span>",
            "<span color='#FF5D62'>█</span>"
        ],
        "tooltip": false,
        "on-click": "kitty --class waybar-tui -e btop"
    },

    "disk": {
        "interval": 120,
        "path": "/",
        "format": "󰋊  {percentage_used}%",
        "tooltip-format": "{used} of {total} on {path}\n{free} free",
        "on-click": "kitty --class waybar-tui -e sh -c 'df -h -x tmpfs -x devtmpfs -x efivarfs; read -n1'"
    },

    // live throughput; hidden when offline (empty format = no pill)
    "network#speed": {
        "interval": 3,
        "format": "󰱦 {bandwidthDownBytes}  󰳘 {bandwidthUpBytes}",
        "format-disconnected": "",
        "tooltip": false
    },

    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°",
        "format-critical": "󱃂 {temperatureC}°",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "tooltip-format": "CPU {temperatureC}°C"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "on-click": "kitty --class waybar-tui -e btop"
    },

    // A muted microphone rides along inside the volume pill as a red mark —
    // silent mics are the kind of state you want to see without asking.
    // middle-click toggles the mic.
    "pulseaudio": {
        "format": "{icon}  {volume}%{format_source}",
        "format-muted": "󰝟  {volume}%{format_source}",
        "format-bluetooth": "󰂰  {volume}%{format_source}",
        "format-source": "",
        "format-source-muted": "  <span color='#E46876'>󰍭</span>",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false
    },

    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  wired",
        "format-disconnected": "󰤭  offline",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} via {gwaddr}\n{bandwidthDownBytes}↓  {bandwidthUpBytes}↑",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr} via {gwaddr}\n{bandwidthDownBytes}↓  {bandwidthUpBytes}↑",
        "tooltip-format-disconnected": "no connection",
        "interval": 5,
        "on-click": "kitty --class waybar-tui -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty --class waybar-tui -e bluetoothctl"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:.1f} W"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "/home/hubert/nixos/home-manager-config-files/waybar/power-menu.sh"
    }
}
