// Waybar — Himal Himal (docs/THEME.md)
//
// Three frosted ink islands. Left is identity (os · workspaces · window · now
// playing), centre is time (Bikram Sambat date · clock · weather), right is
// state (vitals · radios · power).
//
// Live-editable: symlinked from ~/.config/waybar/config.
//   style.css reloads on save;  config changes need `pkill waybar && waybar &`.
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/os",
        "hyprland/workspaces",
        "hyprland/submap",
        "hyprland/window",
        "mpris",
        "custom/cava"
    ],
    "modules-center": [
        "custom/patro",
        "clock",
        "custom/weather"
    ],
    "modules-right": [
        "privacy",
        "systemd-failed-units",
        "group/utils",
        "tray",
        "cpu",
        "temperature",
        "memory",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    // ── left ────────────────────────────────────────────────────────────

    "custom/os": {
        "format": "󱄅",
        "tooltip": false,
        "on-click": "fuzzel",
        "on-click-right": "patro notify"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "१",
            "2": "२",
            "3": "३",
            "4": "४",
            "5": "५",
            "6": "६",
            "7": "७",
            "8": "८",
            "9": "९",
            "10": "१०"
        },
        "on-click": "activate",
        // hyprctl dispatch wraps hl.dispatch(...) under the Lua config manager
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    // active hyprland submap (resize mode) — empty and invisible otherwise
    "hyprland/submap": {
        "format": "󰌌 {}",
        "max-length": 14,
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 38,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Google Chrome": "󰊯  $1",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*) - kitty": "󰆍  $1",
            "(.*) - NVIM": "  $1",
            "nvim (.*)": "  $1",
            "(.*) — Dolphin": "󰉋  $1",
            "Spotify( Premium)?": "󰓇  spotify",
            "Slack \\| (.*)": "󰒱  $1"
        }
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 30,
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "󰐊",
            "spotify": "󰓇",
            "chromium": "󰊯",
            "firefox": "󰈹"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "{player}: {title} — {artist}"
    },

    "custom/cava": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/cava.sh",
        "format": "{}",
        "tooltip": false
    },

    // ── centre ──────────────────────────────────────────────────────────

    // Bikram Sambat — today's Bikram Sambat date (lib/patro.nix).
    // Changes once a day; polled hourly because that costs nothing and keeps
    // the bar honest across midnight without a timer of its own.
    "custom/patro": {
        "exec": "patro waybar",
        "return-type": "json",
        "interval": 3600,
        "on-click": "patro notify",
        "tooltip": true
    },

    "clock": {
        "interval": 60,
        "format": "󰥔  {:%H:%M}",
        "format-alt": "󰸗  {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#E6C384'><b>{}</b></span>",
                "days": "<span color='#DCD7BA'>{}</span>",
                "weekdays": "<span color='#7FB4CA'><b>{}</b></span>",
                "today": "<span color='#7E9CD8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "on-click": "xdg-open https://wttr.in"
    },

    // ── right ───────────────────────────────────────────────────────────

    "privacy": {
        "icon-spacing": 8,
        "icon-size": 14,
        "modules": [
            { "type": "screenshare" },
            { "type": "audio-in" }
        ]
    },

    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "󰀦 {nr_failed}",
        "system": true,
        "user": true
    },

    // Utility drawer — click-actions, not readouts, so they stay folded away
    // behind one glyph and slide out on hover. Nothing here needs watching.
    "group/utils": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "transition-left-to-right": false,
            "children-class": "utils-child",
            "click-to-reveal": false
        },
        "modules": [
            "custom/utils",
            "custom/docker",
            "custom/screenshot",
            "custom/clipboard",
            "custom/wallpaper",
            "idle_inhibitor"
        ]
    },

    "custom/utils": {
        "format": "󰇘",
        "tooltip": false
    },

    "custom/docker": {
        "exec": "/home/hubert/nixos/home-manager-config-files/waybar/docker.sh",
        "return-type": "json",
        "interval": 15,
        "on-click": "kitty --class waybar-tui -e docker stats"
    },

    "custom/screenshot": {
        "format": "󰄀",
        "tooltip": false,
        "on-click": "flameshot gui"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "on-click": "cliphist list | fuzzel --dmenu --width 70 --lines 15 | cliphist decode | wl-copy",
        "tooltip": false
    },

    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip-format": "next wallpaper",
        "on-click": "wallpaper next",
        "on-click-right": "wallpaper random"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "caffeine on — screen stays awake",
        "tooltip-format-deactivated": "caffeine off"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "cpu": {
        "interval": 5,
        "format": "󰻠  {usage}%",
        "tooltip": true,
        "on-click": "kitty --class waybar-tui -e btop"
    },

    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°",
        "format-critical": "󱃂 {temperatureC}°",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "tooltip-format": "CPU {temperatureC}°C"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "on-click": "kitty --class waybar-tui -e btop"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  {volume}%",
        "format-bluetooth": "󰂰  {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false
    },

    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-ethernet": "󰈀  wired",
        "format-disconnected": "󰤭  offline",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} via {gwaddr}\n{bandwidthDownBytes}↓  {bandwidthUpBytes}↑",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr} via {gwaddr}\n{bandwidthDownBytes}↓  {bandwidthUpBytes}↑",
        "tooltip-format-disconnected": "no connection",
        "interval": 5,
        "on-click": "kitty --class waybar-tui -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty --class waybar-tui -e bluetoothctl"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:.1f} W"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "/home/hubert/nixos/home-manager-config-files/waybar/power-menu.sh"
    }
}
